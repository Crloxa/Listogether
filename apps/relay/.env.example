# Relay 配置示例。复制为 .env 使用；不要提交真实密钥或个人路径。
# 应用只从环境变量读取配置。

# HTTP/WS 监听地址
LISTO_RELAY_ADDR=:8080

# 日志级别：debug | info | warn | error
LISTO_RELAY_LOG_LEVEL=info

# 允许访问 API、healthz（CORS）和 WebSocket 的浏览器来源，逗号分隔。
# 互联网部署时改为你的 web 站点来源。
LISTO_RELAY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 新建房间的默认人数上限（2..256）
# LISTO_RELAY_MAX_MEMBERS=16

# 成员断线后被移除前的宽限期（秒，>=5）；期间用原会话重连可恢复身份
# LISTO_RELAY_OFFLINE_TTL_SECONDS=45

# 直连 TLS（HTTPS/WSS）模式的 PEM 证书与私钥路径；两者同时设置才启用。
# 生产推荐：或在反向代理终止 TLS 并透传 WebSocket 升级头。
# LISTO_RELAY_TLS_CERT=/etc/listo/cert.pem
# LISTO_RELAY_TLS_KEY=/etc/listo/key.pem

# Relay 对外可达基址（Phase 4）：OAuth 回调 redirect_uri 由此构造。
# 不设置时 OAuth start 返回"未配置"。例：https://relay.example.com
# LISTO_RELAY_PUBLIC_BASE_URL=

# ---- TURN 短期凭据（D-018，coturn use-auth-secret）----
# 两者齐备时 /api/webrtc/ice 下发短期凭据（username=过期Unix秒 + HMAC-SHA1），
# web 端运行时拉取；缺省时 web 回退 VITE_ICE_SERVERS / 默认 STUN。
# LISTO_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# LISTO_TURN_SECRET=<与 coturn static-auth-secret 相同的高熵密钥>
# LISTO_TURN_TTL_SECONDS=3600

# ---- 平台 API base 覆盖（D-019，接口变更时运维切换）----
# LISTO_PROVIDERS_NETEASE_API_BASE=https://music.163.com
# LISTO_PROVIDERS_QQMUSIC_API_BASE=https://c.y.qq.com
# LISTO_PROVIDERS_SPOTIFY_OEMBED_BASE=https://open.spotify.com
# LISTO_PROVIDERS_SPOTIFY_API_BASE=https://api.spotify.com
# LISTO_PROVIDERS_YOUTUBE_OEMBED_BASE=https://www.youtube.com

# ---- OAuth 平台凭证（Phase 4，D-015）----
# 出现 <ID>_CLIENT_ID 即视为配置该 provider；scope 最小化（默认只读）。
# 端点默认值已内置（Spotify 为官方端点）；其余平台需显式给出 AUTHORIZE_URL/TOKEN_URL。
# token 只存 Relay 内存（D-015），本文件与仓库永远不放真实凭证。
# LISTO_OAUTH_SPOTIFY_CLIENT_ID=
# LISTO_OAUTH_SPOTIFY_CLIENT_SECRET=
# LISTO_OAUTH_SPOTIFY_SCOPES=user-read-private
# LISTO_OAUTH_SPOTIFY_AUTHORIZE_URL=
# LISTO_OAUTH_SPOTIFY_TOKEN_URL=
# LISTO_OAUTH_SPOTIFY_REVOKE_URL=
# LISTO_OAUTH_SPOTIFY_USERINFO_URL=
# LISTO_OAUTH_NETEASE_CLIENT_ID=
# LISTO_OAUTH_NETEASE_AUTHORIZE_URL=
# LISTO_OAUTH_NETEASE_TOKEN_URL=
# LISTO_OAUTH_QQMUSIC_CLIENT_ID=
# LISTO_OAUTH_QQMUSIC_AUTHORIZE_URL=
# LISTO_OAUTH_QQMUSIC_TOKEN_URL=

# 敏感配置规则（AGENTS.md §4）：
# - TURN 用户名/密码等凭据在 Phase 2 引入时只经环境变量注入，不写入仓库文件。
# - token、密码、Cookie、文件路径不得出现在日志、URL 和测试输出。

